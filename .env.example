# cp .env.example .env(與本檔同層);本檔進版控,機密欄位一律留空,填在 .env(已被 .gitignore 排除)
AI_PROVIDER=mock            # mock | aws | local

# ---- 機密(留空;compose 的 env_file 不剝空值後的行內註解,說明一律自成一行)----
# 登入頁與所有 /api/* 的 X-API-Key;留空即無人能登入,必須在 .env 填
API_KEY=
# 文件型態確認的備援;留空=規則判斷不了時交人工,不走 Gemini
GEMINI_API_KEY=
# pgadmin(http://localhost:5050)登入;必填,compose 無預設值
PGADMIN_EMAIL=
PGADMIN_PASSWORD=
# compose 的 postgres 服務讀它;POSTGRES_URL 的密碼必須與之相同,必填
POSTGRES_PASSWORD=

# ---- aws ----
AWS_REGION=us-west-2
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-6
S3_BUCKET=appeal-ai-000000000000
DDB_LAW_TABLE=appeal_law_articles
# 法條表以「法規名稱#條號」為主鍵時留空;該鍵只是 GSI 時填索引名,查詢改走逐鍵 query
DDB_LAW_INDEX=
# 法條修正日期的屬性名;留空即 amend_date
DDB_LAW_DATE_FIELD=
DDB_CASE_TABLE=appeal_cases
KB_LAW_ID=WQVGZBCEUA
KB_CASE_ID=HEVPST3YK1
# 憑證不在這裡:boto3 讀 ~/.aws/credentials [default],compose 以唯讀掛進容器,絕不 build 進 image
# 留空=依 AI_PROVIDER 自動(mock→memory, aws→dynamodb, local→postgres)
CASE_STORE=

# ---- local ----
LOCAL_LLM_BASE_URL=http://host.docker.internal:11434
LOCAL_LLM_MODEL=kamekichi128/qwen3-4b-instruct-2507
LOCAL_EMBED_MODEL=bge-m3
LOCAL_VISION_MODEL=qwen2.5vl:7b
# ollama 單次請求逾時秒數。地端模型生一份 F4 草稿在慢機器上可達數分鐘,評測整批更久;
# 調小會把正常的慢生成誤判成失敗
LOCAL_LLM_TIMEOUT=300
# 密碼需與上方機密區 POSTGRES_PASSWORD 一致;host 是 postgres(容器網路內部服務名),只在容器網路內可達
POSTGRES_URL=
# 主機端腳本(local_setup/ 建索引)用;同一個資料庫,但走 compose 對外 port:
# postgresql://appeal:<POSTGRES_PASSWORD>@localhost:5433/appeal。留空則退回上面那行
POSTGRES_URL_HOST=

# ---- 選填 ----
APPEAL_AGENCY_LOCATION=新北市   # 查在途期間對照表用
DECISION_FONT_FILE=/usr/share/fonts/truetype/uming-tw.ttf    # 這就是預設值;此檔不存在才退回 fitz china-t(PDF 文字複製出來是亂碼)
FINALIZED_DIR=/app/finalized                                # 定稿 PDF 落地目錄,在容器內、砍容器就沒了;aws 模式落 S3,不看此變數
CASE_FILES_DIR=/data/case_files                             # 上傳 PDF 落地目錄(供文件確認頁預覽);aws 模式落 S3 cases/ 前綴,不看此變數;這就是預設值
# 上傳 PDF 的主機端存放路徑,掛進容器的 CASE_FILES_DIR;留空=../../data/case_files
CASE_FILES_HOST_DIR=
# postgres 資料夾的主機絕對路徑(正斜線);留空=named volume pgdata。本機路徑填在 .env,不進版控
PG_DATA_DIR=
# 前處理產出(markdown 原文)的主機路徑,掛進容器給「原文檢視」讀;留空=../../data/output
DATA_OUTPUT_DIR=
