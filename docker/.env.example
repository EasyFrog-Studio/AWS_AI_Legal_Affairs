# 複製為 .env 後使用:cp .env.example .env
# ---- 共通 ----
AI_PROVIDER=mock            # mock | aws | local
API_KEY=demo-key-2026
# ---- aws 模式 ----
AWS_REGION=us-west-2
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-6
# KB_LAW_ID / KB_CASE_ID:aws_setup/resources.json 產出後填入
# 值留空的變數,註解必須自成一行:docker compose 的 env_file 不剝行內註解,
# 「KEY=   # 說明」會讓值變成那串註解文字,而不是空字串
KB_LAW_ID=
KB_CASE_ID=
S3_BUCKET=appeal-ai-047877300727
DDB_LAW_TABLE=appeal_law_articles
DDB_CASE_TABLE=appeal_cases
# CASE_STORE 留空=依 AI_PROVIDER 自動(mock→memory, aws→dynamodb, local→postgres)
CASE_STORE=
# GEMINI_API_KEY:文件型態確認的規則判斷不出來時備援;留空=一律回「無法確認」交人工核對
GEMINI_API_KEY=
# ---- local 模式 ----
LOCAL_LLM_BASE_URL=http://host.docker.internal:11434
LOCAL_LLM_MODEL=kamekichi128/qwen3-4b-instruct-2507
LOCAL_EMBED_MODEL=bge-m3
POSTGRES_URL=postgresql://appeal:appeal@postgres:5432/appeal
LOCAL_VISION_MODEL=qwen2.5vl:7b   # 掃描件逐頁抽字用的多模態模型(app/ocr.py)
# DECISION_FONT_FILE:決定書 PDF 的內嵌楷體(AR PL UKai TW,由 image 的 font stage 拆出),
# 檔案不存在時退回 fitz 內建 china-t(畫得出來,但 PDF 文字複製出來是亂碼)
#DECISION_FONT_FILE=/usr/share/fonts/truetype/ukai-tw.ttf
# ---- 期間計算與定稿 ----
APPEAL_AGENCY_LOCATION=新北市      # 受理訴願機關所在地,查在途期間對照表用
#FINALIZED_DIR=/app/finalized   # 定稿 PDF 落地目錄;不設即用程式碼層根目錄下的 finalized/(aws 模式改落 S3,不看這個變數)
